# Виртуальное окружение
venv/

# Файл с секретными ключами
.env

# Файлы сессии Telethon (чтобы никто не украл твой тг-аккаунт)
*.session

# Файл базы данных
*.db

# Кэш питона
__pycache__/

# Логи выполнения (runtime-артефакты, не код)
*.log

